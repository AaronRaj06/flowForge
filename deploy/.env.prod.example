# Copy to deploy/.env.prod and fill in. Never commit the real file.
POSTGRES_PASSWORD="change-me"
# Both must be random and at least 32 characters, or the server refuses to start. Generate with: openssl rand -hex 32
JWT_SECRET="long-random-string"
TOKEN_ENCRYPTION_KEY="another-long-random-string"
# The public address of the site (nginx serves the app and proxies the API on the same origin).
PUBLIC_URL="https://flowforge.example.com"
WEB_URL="https://flowforge.example.com"
PORT=4000
# LLM provider (see server/.env.example for Gemini via the OpenAI-compatible endpoint).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DAILY_TOKEN_BUDGET=50000
WORKER_CONCURRENCY=5
# Finished runs older than this are deleted by the worker (0 keeps them forever).
RUN_RETENTION_DAYS=90
# Optional managed services instead of the bundled containers:
# DATABASE_URL="postgresql://user:pass@host:5432/flowforge"
# REDIS_URL="rediss://default:pass@host:6379"

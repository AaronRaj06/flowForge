{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/api/index.ts",
    "worker": "tsx watch --env-file=.env src/worker.ts",
    "test": "tsx --env-file=.env --test test/*.test.ts",
    "test-run": "tsx --env-file=.env scripts/test-run.ts",
    "smoke": "tsx scripts/smoke.ts",
    "reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-db.ts pre && prisma db push && tsx --env-file-if-exists=.env scripts/setup-db.ts post"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.2",
    "cors": "^2.8.6",
    "cron-parser": "^4.9.0",
    "express": "^5.3.0",
    "gpt-tokenizer": "4.0.4",
    "ioredis": "^6.0.0",
    "isolated-vm": "6.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "openai": "^7.54.0",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

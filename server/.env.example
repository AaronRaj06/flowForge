DATABASE_URL="postgresql://aaranraj@localhost:5432/flowforge"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-secret-change-me"
PORT=4000
PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:5173"
# LLM provider. Leave all three keys empty to use the built-in mock LLM/embeddings provider.
# Google Gemini (free key from aistudio.google.com/apikey) is the default for new blocks and also does the embeddings.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-lite-latest"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OPENAI_BASE_URL=""            # any other OpenAI-compatible provider
# OPENAI_MODEL=""
# OPENAI_EMBEDDING_MODEL=""
# Daily token budget per user (enforced before a run is enqueued).
DAILY_TOKEN_BUDGET=50000
# Optional: your blended price in USD per million tokens, to show costs in money as well as tokens.
# TOKEN_COST_PER_MILLION=0.5
# OAuth apps (Phase 3). Integrations show "not configured" until set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# LLM resilience: SDK retries on 429/5xx (default 3), then one try on this model if the main one still fails.
# LLM_MAX_RETRIES=3
# LLM_FALLBACK_MODEL="gemini-flash-latest"
# Finished runs older than this many days are deleted by the worker (0 keeps everything).
# RUN_RETENTION_DAYS=90

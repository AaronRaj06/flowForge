generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")

}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  pipelines    Pipeline[]
  runs         Run[]
  tokens       IntegrationToken[]
  templates    Template[]
  deployments  Deployment[]
  chunks       KnowledgeChunk[]
  credentials  Credential[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  createdAt    DateTime           @default(now())
}

model Team {
  id               String       @id @default(uuid())
  name             String
  /// Tokens all of the team's pipelines may use per day (on top of each member's own budget).
  dailyTokenBudget Int?
  members          Membership[]
  pipelines        Pipeline[]
  auditEvents      AuditEvent[]
  createdAt        DateTime     @default(now())
}

model Membership {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // owner | editor | viewer
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

/// Who did what, for team activity feeds and personal history.
model AuditEvent {
  id         String   @id @default(uuid())
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String // e.g. pipeline.update, member.add, run.start
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
}

/// API keys and tokens for key-based integrations (Discord, Telegram, Notion, GitHub, Airtable), shared across pipelines.
model Credential {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String // discord | telegram | notion | github | airtable
  secret    String // AES-GCM encrypted
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Pipeline {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when the pipeline belongs to a team workspace; its members get access by role.
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name        String
  description String?
  graph       Json // { nodes: [], edges: [] }
  /// Pipeline to run when a run of this one fails (its input describes the failure).
  errorPipelineId String?
  /// Stop a run once its LLM blocks have used this many tokens (guards against runaway loops).
  maxTokensPerRun Int?
  runs        Run[]
  deployments Deployment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Run {
  id           String      @id @default(uuid())
  // null for ad-hoc runs of an unsaved canvas
  pipelineId   String?
  pipeline     Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deploymentId String?
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       RunStatus   @default(PENDING)
  graph        Json // snapshot of the graph that was executed
  input        Json?
  output       Json?
  error        String?
  tokensUsed   Int         @default(0)
  /// While WAITING: { context, nodeId, request } so the run can resume after an approval decision.
  checkpoint   Json?
  events       RunEvent[]
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  @@index([userId, startedAt])
  @@index([deploymentId, startedAt])
}

model RunEvent {
  id        String    @id @default(uuid())
  runId     String
  run       Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String
  status    String // pending | running | success | error | skipped | auth_error | waiting
  output    Json?
  error     String?
  tokens    Int       @default(0) // LLM tokens this block used in the run
  startedAt DateTime?
  endedAt   DateTime?

  @@unique([runId, nodeId])
}

model IntegrationToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // gmail | slack | sheets
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  @@unique([userId, provider])
}

model Template {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  graph       Json
  variables   Json // [{ key, description, defaultValue }]
  public      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Deployment {
  id             String    @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // cron | webhook | api | form
  cronExpression String?
  /// Form deployments: field labels shown on the public form, and whether it takes a file.
  formFields     String[]  @default([])
  formFile       Boolean   @default(false)
  webhookSecret  String?
  syncTimeout    Int       @default(30)
  active         Boolean   @default(true)
  lastRunAt      DateTime?
  runs           Run[]
  createdAt      DateTime  @default(now())
}

model KnowledgeChunk {
  id         String                       @id @default(uuid())
  userId     String
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFile String
  chunkText  String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@map("knowledge_chunks")
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING
  SUCCESS
  ERROR
  CANCELLED
}
